{
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "pattern": "^[A-Za-z0-9_-]{1,96}$",
      "title": "Device Id",
      "type": "string"
    },
    "workspace_id": {
      "default": "default",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
      "title": "Workspace Id",
      "type": "string"
    },
    "operation": {
      "maxLength": 96,
      "pattern": "^[a-z]+\\.[a-z_]+$",
      "title": "Operation",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "timeout_ms": {
      "anyOf": [
        {
          "maximum": 86400000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeout Ms"
    },
    "execution_mode": {
      "default": "sync",
      "enum": [
        "sync",
        "job"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!-~]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "execution_profile_id": {
      "default": "read_only",
      "enum": [
        "read_only",
        "standard",
        "trusted_personal"
      ],
      "title": "Execution Profile Id",
      "type": "string"
    },
    "approval_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,96}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    }
  },
  "required": [
    "device_id",
    "operation",
    "payload"
  ],
  "title": "OperationInput",
  "type": "object"
}
