{
  "$defs": {
    "LocalPermissions": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "grants": {
          "additionalProperties": {
            "enum": [
              "allow",
              "deny",
              "require_approval"
            ],
            "type": "string"
          },
          "maxProperties": 256,
          "title": "Grants",
          "type": "object"
        },
        "disabled_categories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 18,
          "title": "Disabled Categories",
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/PermissionConstraints"
        }
      },
      "title": "LocalPermissions",
      "type": "object"
    },
    "PermissionConstraints": {
      "additionalProperties": false,
      "properties": {
        "workspace_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Workspace Ids",
          "type": "array"
        },
        "max_timeout_ms": {
          "default": 86400000,
          "maximum": 86400000,
          "minimum": 1,
          "title": "Max Timeout Ms",
          "type": "integer"
        },
        "max_output_bytes": {
          "default": 1073741824,
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "executable_allowlist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Executable Allowlist",
          "type": "array"
        },
        "executable_denylist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Executable Denylist",
          "type": "array"
        },
        "strict_os_isolation": {
          "const": false,
          "default": false,
          "title": "Strict Os Isolation",
          "type": "boolean"
        }
      },
      "title": "PermissionConstraints",
      "type": "object"
    },
    "WorkspaceSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "WorkspaceSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2,
      "default": 2,
      "title": "Version",
      "type": "integer"
    },
    "gateway": {
      "maxLength": 2048,
      "title": "Gateway",
      "type": "string"
    },
    "device_id": {
      "pattern": "^[A-Za-z0-9_-]{1,96}$",
      "title": "Device Id",
      "type": "string"
    },
    "workspace": {
      "format": "path",
      "title": "Workspace",
      "type": "string"
    },
    "allowed_workspaces": {
      "items": {
        "$ref": "#/$defs/WorkspaceSpec"
      },
      "maxItems": 15,
      "title": "Allowed Workspaces",
      "type": "array"
    },
    "data_dir": {
      "format": "path",
      "title": "Data Dir",
      "type": "string"
    },
    "profile": {
      "default": "read_only",
      "enum": [
        "read_only",
        "standard",
        "trusted_personal"
      ],
      "title": "Profile",
      "type": "string"
    },
    "ca_file": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ca File"
    },
    "desktop_enabled": {
      "default": false,
      "title": "Desktop Enabled",
      "type": "boolean"
    },
    "permissions": {
      "$ref": "#/$defs/LocalPermissions"
    }
  },
  "required": [
    "gateway",
    "device_id",
    "workspace",
    "data_dir",
    "permissions"
  ],
  "title": "AgentSettings",
  "type": "object"
}
