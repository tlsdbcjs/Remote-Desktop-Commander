{
  "$defs": {
    "Command": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "info",
            "start",
            "status",
            "stop",
            "activity",
            "settings"
          ],
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "Command",
      "type": "object"
    },
    "Enrollment": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "enroll",
          "title": "Action",
          "type": "string"
        },
        "gateway": {
          "maxLength": 2048,
          "title": "Gateway",
          "type": "string"
        },
        "workspace": {
          "format": "path",
          "title": "Workspace",
          "type": "string"
        },
        "ca_file": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ca File"
        },
        "profile": {
          "default": "read_only",
          "enum": [
            "read_only",
            "standard",
            "trusted_personal"
          ],
          "title": "Profile",
          "type": "string"
        },
        "token": {
          "maxLength": 128,
          "minLength": 20,
          "title": "Token",
          "type": "string"
        },
        "allowed_workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceSpec"
          },
          "maxItems": 15,
          "title": "Allowed Workspaces",
          "type": "array"
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalPermissions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "desktop_enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "action",
        "gateway",
        "workspace",
        "token"
      ],
      "title": "Enrollment",
      "type": "object"
    },
    "ImportConnection": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "enroll_connection",
          "title": "Action",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "workspace": {
          "format": "path",
          "title": "Workspace",
          "type": "string"
        },
        "profile": {
          "default": "read_only",
          "enum": [
            "read_only",
            "standard",
            "trusted_personal"
          ],
          "title": "Profile",
          "type": "string"
        },
        "allowed_workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceSpec"
          },
          "maxItems": 15,
          "title": "Allowed Workspaces",
          "type": "array"
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalPermissions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "desktop_enabled": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "action",
        "path",
        "file_sha256",
        "workspace"
      ],
      "title": "ImportConnection",
      "type": "object"
    },
    "InspectConnection": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "inspect_connection",
          "title": "Action",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "action",
        "path"
      ],
      "title": "InspectConnection",
      "type": "object"
    },
    "SettingsUpdate": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "update_settings",
          "title": "Action",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision",
          "type": "string"
        },
        "gateway": {
          "maxLength": 2048,
          "title": "Gateway",
          "type": "string"
        },
        "workspace": {
          "format": "path",
          "title": "Workspace",
          "type": "string"
        },
        "ca_file": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ca File"
        },
        "profile": {
          "enum": [
            "read_only",
            "standard",
            "trusted_personal"
          ],
          "title": "Profile",
          "type": "string"
        },
        "allowed_workspaces": {
          "items": {
            "$ref": "#/$defs/WorkspaceSpec"
          },
          "maxItems": 15,
          "title": "Allowed Workspaces",
          "type": "array"
        },
        "desktop_enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desktop Enabled"
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalPermissions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action",
        "revision",
        "gateway",
        "workspace",
        "profile"
      ],
      "title": "SettingsUpdate",
      "type": "object"
    },
    "WorkspaceSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "WorkspaceSpec",
      "type": "object"
    },
    "LocalPermissions": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "grants": {
          "additionalProperties": {
            "enum": [
              "allow",
              "deny",
              "require_approval"
            ],
            "type": "string"
          },
          "maxProperties": 256,
          "title": "Grants",
          "type": "object"
        },
        "disabled_categories": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 18,
          "title": "Disabled Categories",
          "type": "array"
        },
        "constraints": {
          "$ref": "#/$defs/PermissionConstraints"
        }
      },
      "title": "LocalPermissions",
      "type": "object"
    },
    "PermissionConstraints": {
      "additionalProperties": false,
      "properties": {
        "workspace_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Workspace Ids",
          "type": "array"
        },
        "max_timeout_ms": {
          "default": 86400000,
          "maximum": 86400000,
          "minimum": 1,
          "title": "Max Timeout Ms",
          "type": "integer"
        },
        "max_output_bytes": {
          "default": 1073741824,
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "executable_allowlist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Executable Allowlist",
          "type": "array"
        },
        "executable_denylist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Executable Denylist",
          "type": "array"
        },
        "strict_os_isolation": {
          "const": false,
          "default": false,
          "title": "Strict Os Isolation",
          "type": "boolean"
        }
      },
      "title": "PermissionConstraints",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "activity": "#/$defs/Command",
      "enroll": "#/$defs/Enrollment",
      "enroll_connection": "#/$defs/ImportConnection",
      "info": "#/$defs/Command",
      "inspect_connection": "#/$defs/InspectConnection",
      "settings": "#/$defs/Command",
      "start": "#/$defs/Command",
      "status": "#/$defs/Command",
      "stop": "#/$defs/Command",
      "update_settings": "#/$defs/SettingsUpdate"
    },
    "propertyName": "action"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Command"
    },
    {
      "$ref": "#/$defs/Enrollment"
    },
    {
      "$ref": "#/$defs/InspectConnection"
    },
    {
      "$ref": "#/$defs/ImportConnection"
    },
    {
      "$ref": "#/$defs/SettingsUpdate"
    }
  ]
}
