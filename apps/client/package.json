{
  "name": "@racp/client",
  "version": "0.1.21",
  "private": true,
  "description": "RACP cross-platform PC client",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "tauri dev",
    "package": "node ../../scripts/build-client.mjs",
    "package:win": "pnpm run package",
    "package:mac": "tauri build --target x86_64-apple-darwin",
    "package:linux": "tauri build --target x86_64-unknown-linux-gnu"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tauri-apps/api": "2.12.1"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@tauri-apps/cli": "2.10.1"
  }
}
