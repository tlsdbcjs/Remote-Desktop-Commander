{
  "name": "@racp/client",
  "version": "0.1.10",
  "private": true,
  "description": "RACP cross-platform PC client",
  "main": "main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package": "electron-builder --config electron-builder.cjs",
    "package:win": "pnpm run package --win --x64 --publish never",
    "package:mac": "pnpm run package --mac --publish never",
    "package:linux": "pnpm run package --linux --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "vite": "8.3.2",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@playwright/test": "1.63.0"
  }
}
