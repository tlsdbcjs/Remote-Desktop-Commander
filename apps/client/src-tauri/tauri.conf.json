{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RACP Client",
  "version": "0.1.21",
  "identifier": "app.racp.client",
  "build": {
    "beforeDevCommand": "pnpm exec vite --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../renderer-dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../assets/app.ico",
      "../assets/app.png"
    ],
    "resources": {
      "staged/agent/": "agent/",
      "staged/webview2/": "webview2/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "staged/webview2"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "installerHooks": "installer.nsh"
      }
    }
  }
}
