{
  "appId": "app.racp.client",
  "productName": "RACP Client",
  "files": [
    "main.cjs",
    "preload.cjs",
    "backend.cjs",
    "login.cjs",
    "controller.cjs",
    "errors.cjs",
    "messages.json",
    "assets/**",
    "renderer-dist/**",
    "package.json"
  ],
  "asar": true,
  "beforePack": "./before-pack.cjs",
  "win": {
    "target": [
      "nsis",
      "portable",
      "zip"
    ],
    "signAndEditExecutable": true,
    "signExecutable": false,
    "icon": "assets/app.ico"
  },
  "nsis": {
    "artifactName": "RACP-Client-${version}-win-${arch}-setup.${ext}",
    "include": "build/installer.nsh",
    "deleteAppDataOnUninstall": false,
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  },
  "portable": {
    "artifactName": "RACP-Client-${version}-win-${arch}-portable.${ext}",
    "requestExecutionLevel": "user"
  },
  "artifactName": "RACP-Client-${version}-${os}-${arch}.${ext}",
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.utilities"
  },
  "linux": {
    "executableName": "racp-client",
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Utility",
    "maintainer": "RACP maintainers"
  }
}
