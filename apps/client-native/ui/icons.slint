// Stroke icon. SVG stroke-width is expressed in viewBox units and scaled to the icon size,
// and the colour is explicit, which avoids the black `currentColor` icons seen in the Iced client.
export component Icon inherits Path {
    in property <string> data;
    in property <brush> tint: white;
    in property <float> weight: 2;
    width: 16px;
    height: 16px;
    commands: data;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: self.width * weight / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    accessible-role: none;
}
