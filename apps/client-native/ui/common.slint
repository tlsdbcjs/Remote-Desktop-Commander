// Building blocks shared by the page views.
import { Theme } from "theme.slint";
import { Button } from "widgets.slint";

export component SectionTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;
    Text {
        text: title;
        font-size: Theme.fs-sm;
        font-weight: 700;
        color: Theme.text-strong;
        wrap: word-wrap;
    }
    if subtitle != "": Text {
        text: subtitle;
        font-size: Theme.fs-xs;
        color: Theme.text-400;
        wrap: word-wrap;
    }
}

export component FieldLabel inherits Text {
    font-size: Theme.fs-xs;
    font-weight: 500;
    color: Theme.text-400;
}

export component IdentityItem inherits HorizontalLayout {
    in property <string> name;
    in property <string> value;
    spacing: 4px;
    Text {
        text: name;
        font-size: Theme.fs-11;
        color: Theme.text-500;
        horizontal-stretch: 0;
    }
    Text {
        text: value;
        font-family: Theme.mono;
        font-size: Theme.fs-11;
        color: Theme.text-300;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

export component ChoiceButton inherits Button {
    in property <bool> selected;
    fill: selected ? Theme.indigo-600 : Theme.hover-800;
    hover-fill: selected ? Theme.indigo-500 : Theme.hover-700;
    fg: selected ? white : Theme.text-300;
    pad-x: 12px;
    pad-y: 6px;
    accessible-checkable: true;
    accessible-checked: selected;
}

export component PrimaryButton inherits Button {
    fill: Theme.indigo-600;
    hover-fill: Theme.indigo-500;
    fg: white;
    pad-x: 14px;
    pad-y: 7px;
    radius: Theme.r-lg;
}

export component DangerButton inherits Button {
    fg: Theme.rose-400;
    fill: Theme.rose-500.with-alpha(0.1);
    hover-fill: Theme.rose-500.with-alpha(0.2);
    outline: Theme.rose-500.with-alpha(0.3);
    pad-x: 12px;
    pad-y: 6px;
    radius: Theme.r-lg;
}
